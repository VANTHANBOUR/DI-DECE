rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Bootstrapped Super Administrator from runtime context
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vanthanbour@diu.edu.kh' ||
        (request.auth.token.email is string && request.auth.token.email.matches('.*admin.*'))
      );
    }

    function isUserAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (exists(/databases/$(database)/documents/users/$('fb_' + request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$('fb_' + request.auth.uid)).data.role == 'admin')
        )
      );
    }

    function isUserAcademicOfficer() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'academic_officer') ||
          (exists(/databases/$(database)/documents/users/$('fb_' + request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$('fb_' + request.auth.uid)).data.role == 'academic_officer')
        )
      );
    }

    function isAcademicAuthority() {
      return isUserAdmin() || isUserAcademicOfficer();
    }

    function isUserSelf(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || 
        userId == ('fb_' + request.auth.uid) ||
        (request.auth.token.email is string && existing().email == request.auth.token.email)
      );
    }

    // --- Entity Validation Functions ---
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 150 &&
        data.email is string && data.email.size() <= 150 &&
        data.role is string && (data.role in ['admin', 'academic_officer', 'teacher']) &&
        data.title is string && data.title.size() <= 150;
    }

    function isValidLessonPlan(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.teacherId is string && data.teacherId.size() <= 128 &&
        data.themeTitle is string && data.themeTitle.size() <= 500 &&
        data.status is string;
    }

    function isValidClassroom(data) {
      return data.id is string && data.id.size() <= 100 &&
        data.name is string && data.name.size() <= 100 &&
        data.ageGroup is string && data.ageGroup.size() <= 50;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.timestamp is string &&
        data.actorId is string && data.actorId.size() <= 128 &&
        data.action is string && data.action.size() <= 100;
    }

    // --- Collection Security Rules ---

    // 1. Settings & School Profile (Branding, Logo, Calendar)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // 2. User Profiles & Faculty Directory
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // 3. Lesson Plans (Core Approval Workflow)
    match /lessonPlans/{planId} {
      allow read: if true;
      allow create, update, delete: if isValidId(planId);
    }

    // 4. Classrooms
    match /classrooms/{classId} {
      allow read: if true;
      allow create, update: if isValidId(classId) && isValidClassroom(incoming());
      allow delete: if isValidId(classId);
    }

    // 5. School Grade Levels
    match /levels/{levelId} {
      allow read: if true;
      allow create, update, delete: if isValidId(levelId);
    }

    // 6. System Audit Logs (Append-only)
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false; // Immutable audit log
    }

    // 7. System Connection Health Check
    match /system/{docId} {
      allow read, write: if isValidId(docId);
    }

    // 8. Deleted Accounts Sync (Tombstones)
    match /deletedAccounts/{userId} {
      allow read, write: if isValidId(userId);
    }

    // 9. Deleted Lesson Plans Sync (Tombstones)
    match /deletedPlans/{planId} {
      allow read, write: if isValidId(planId);
    }
  }
}

